PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/redwine

# Comma-separated list of VERIFIED emails allowed into /admin (checked on the server only).
# Alternatively give a user the Firebase custom claim { admin: true }.
ADMIN_EMAILS=you@example.com

# Option A: set GOOGLE_APPLICATION_CREDENTIALS to an absolute path outside this repo.
# Option B: provide service-account JSON as one line (secure server environment only).
FIREBASE_SERVICE_ACCOUNT_JSON=
